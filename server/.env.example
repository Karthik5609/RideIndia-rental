NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ride_india
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.com
CORS_ALLOWED_ORIGIN_SUFFIXES=localhost,127.0.0.1,onrender.com,netlify.app
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=400
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_BOOKING_MAX_REQUESTS=80
KYC_AUTO_APPROVE=true
PAYMENTS_MOCK_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
